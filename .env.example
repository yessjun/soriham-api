# 머신별 실제 값은 .env에 (커밋 금지 — .gitignore 등재)
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://soriham:<postgres-password>@localhost:5432/soriham
# 스캔·감시할 녹음 폴더 (여러 개면 콜론으로 구분).
# UPLOAD_DIR과 겹치면 기동을 거부한다 — 겹치면 업로드본이 스캔에 집혀
# 다른 워크스페이스의 녹음으로 등록된다
AUDIO_DIRS=<recordings-folder>
# serve 프로세스도 이 값을 알아야 스캔 녹음의 오디오를 내보낼 수 있다 —
# 없으면 허용된 뿌리가 없어 전부 404가 된다
# 스캔·감시가 녹음을 넣을 워크스페이스 슬러그 (업로드는 요청한 사람의 워크스페이스로 간다)
# 없으면 soriham-api bootstrap 이나 create-workspace 로 먼저 만든다
DEFAULT_WORKSPACE=<workspace-slug>
# stt 러너 주소. 원격 러너처럼 파일시스템을 공유하지 않으면 RUNNER_UPLOAD=true
RUNNER_URL=http://localhost:8100
RUNNER_UPLOAD=false
# 비우면 러너 기본 모델과 언어 자동 감지
STT_MODEL=
STT_LANGUAGE=ko
# 제목/요약/태그 생성: ollama(기본) | claude | off. claude는 ANTHROPIC_API_KEY 필요
ENRICH_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=<anthropic-api-key>
# 콘솔 오리진(콤마 구분). LAN 서빙 시 콘솔 주소로 교체.
# 쿠키를 실어 보내므로 *를 쓸 수 없다 — 쓰면 기동을 거부한다
CORS_ORIGINS=http://localhost:5174
# 세션 쿠키. 로컬 http 개발에서만 COOKIE_SECURE=false
COOKIE_SECURE=true
# 가입을 승인 없이 바로 활성으로 (기본 false — 승인제)
AUTO_APPROVE=false
# /docs, /openapi.json 노출 (기본 false — 라우트 목록이 정찰 재료다)
EXPOSE_DOCS=false
# 사용량 한도는 환경 변수가 아니라 워크스페이스마다 따로 정한다 (soriham-api quota).
# 새로 생긴 워크스페이스는 무제한으로 시작한다
